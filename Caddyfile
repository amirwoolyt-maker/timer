{$APP_ADDRESS::8080} {
	root * {$APP_ROOT:build/web}
	encode zstd gzip

	header {
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		Cross-Origin-Resource-Policy "same-origin"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Revalidate entry points after deploying a corrected build.
		Cache-Control "no-cache"
	}

	handle /healthz {
		respond "ok" 200
	}

	# Missing scripts/fonts/WASM must return 404 rather than index.html.
	@assets path_regexp assets \.[a-zA-Z0-9]+$
	handle @assets {
		file_server
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
